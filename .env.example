# ==============================================================================
# Driver Drowsiness and Health Monitoring System - Environment Configuration
# Copy this file to .env and configure your local settings.
# NEVER commit the active .env file containing live secrets to version control.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Vision Configuration
CAMERA_INDEX=0
VISION_FRAME_RATE=15
EYE_CLOSURE_THRESHOLD_MS=1500
YAWN_DURATION_THRESHOLD_MS=2000
HEAD_NOD_PITCH_THRESHOLD=25.0

# Smartwatch Sensor Configuration
# Options: SIMULATED | BOULT_BLE | DISABLED
SMARTWATCH_SOURCE=SIMULATED
BOULT_MAC_ADDRESS=00:00:00:00:00:00
SENSOR_POLL_INTERVAL_SEC=2.0

# Android GPS Configuration
# Options: MOCK | HTTP_BRIDGE | DISABLED
GPS_SOURCE=MOCK
GPS_BRIDGE_LISTEN_PORT=8080
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946

# Alerts and SOS Configuration
ENABLE_AUDIO_BEEPS=true
BEEP_FREQUENCY_HZ=2500
BEEP_DURATION_MS=400

# SMS Provider Configuration
# Options: mock | twilio | fast2sms
# Default MUST remain 'mock' to prevent accidental external network charges
SMS_PROVIDER=mock

# Twilio Credentials (Required ONLY if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=AC_PLACEHOLDER_ACCOUNT_SID
TWILIO_AUTH_TOKEN=PLACEHOLDER_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+10000000000

# Fast2SMS Credentials (Required ONLY if SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=PLACEHOLDER_FAST2SMS_API_KEY

# Emergency Contact (E.164 international format e.g. +919876543210)
EMERGENCY_CONTACT_PHONE=+910000000000
EMERGENCY_CONTACT_NAME="Primary Emergency Contact"

# Alert Escalation & Anti-Spam Cooldown (seconds)
ALERT_SMS_COOLDOWN_SECONDS=120
ALERT_DEBOUNCE_WINDOW_MS=500
